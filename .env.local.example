# Medicamentum360 — Variables de entorno
# NOTA: Esto es un archivo de ejemplo. Copia a .env.local y completa los valores reales.
# NUNCA commitees .env.local — está en .gitignore

# ===== Database =====
# InsForge Postgres connection string (obtén desde tu dashboard de InsForge)
DATABASE_URL="postgresql://user:password@host:5432/medicamentum360"

# ===== Better Auth =====
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET="tu-secret-de-32-caracteres-aqui"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Google OAuth =====
# Obtén estas credenciales de: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# ===== Wompi (pagos) =====
# Pruebas: usa credenciales de ambiente test de Wompi
# Producción: actualiza con credenciales reales
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_EVENTS_SECRET="tu-wompi-webhook-secret"

# ===== Moodle (entorno LOCAL de pruebas) =====
# Auto-generado por docker/moodle-bootstrap.php
# Después de `docker compose up -d` en docker/, copia el contenido de docker/output/.env.moodle.local aquí:
MOODLE_BASE_URL="http://localhost:8090"
MOODLE_WS_TOKEN="tu-moodle-token-aqui"

# ===== Meilisearch (búsqueda) =====
# Opcional en MVP, requiere instancia de Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="tu-meilisearch-api-key"

# ===== InsForge (obtén con npx @insforge/cli secrets get <KEY>) =====
INSFORGE_JWT_SECRET="tu-insforge-jwt-secret"
NEXT_PUBLIC_INSFORGE_BASE_URL="https://tu-proyecto.region.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="tu-insforge-anon-key"

# ===== InsForge Storage (imágenes, PDFs) =====
INSFORGE_STORAGE_URL="https://storage.insforge.io"
INSFORGE_STORAGE_KEY="tu-insforge-storage-key"

# ===== Configuración de marca =====
NEXT_PUBLIC_BRAND_COLOR="#8127cf"
NEXT_PUBLIC_BRAND_NAME="Medicamentum360"

# ===== Logging y debug =====
DEBUG="false"
NODE_ENV="development"
