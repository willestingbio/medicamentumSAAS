# Medicamentum360 — Variables de entorno (ejemplo)
# NOTA: Copia a .env.local y completa los valores reales. NUNCA commitees .env.local.

# ===== Database =====
# Postgres local de desarrollo (Docker o local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicamentum360"

# ===== Better Auth =====
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET="tu-secret-de-32-caracteres-aqui"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Google OAuth =====
# Obtén de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# ===== Wompi (pagos) =====
# Pruebas: ambiente test de Wompi. Producción: credenciales reales.
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_EVENTS_SECRET="tu-wompi-webhook-secret"

# ===== Moodle (entorno LOCAL de pruebas) =====
# Auto-generado por docker/moodle-bootstrap.php
# Después de docker compose up -d en docker/, copia de docker/output/.env.moodle.local:
MOODLE_BASE_URL="http://localhost:8090"
MOODLE_WS_TOKEN="tu-moodle-token"

# ===== Redis (opcional — solo para producción con Better Auth) =====
# REDIS_URL="redis://localhost:6379"

# ===== Meilisearch (desarrollo local) =====
# MEILI_HOST="http://localhost:7700"
# MEILI_MASTER_KEY="dev_master_key_123"

# ===== Storage — Cloudflare R2 (producción) =====
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY="..."
# STORAGE_SECRET_KEY="..."
# STORAGE_BUCKET="medicamentum360"
# STORAGE_PUBLIC_URL="https://storage.medicamentum360.com"

# ===== Email — Brevo =====
# BREVO_API_KEY="..."

# ===== Configuración de marca =====
NEXT_PUBLIC_BRAND_COLOR="#8127cf"
NEXT_PUBLIC_BRAND_NAME="Medicamentum360"

# ===== Logging =====
DEBUG="false"
NODE_ENV="development"
