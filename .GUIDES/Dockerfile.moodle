# docker/Dockerfile.moodle — Imagen Moodle auto-instalada para pruebas locales
FROM php:8.3-apache

ENV MOODLE_VERSION=MOODLE_405_STABLE

RUN apt-get update && apt-get install -y \
    git \
    curl \
    libzip-dev \
    libxml2-dev \
    libicu-dev \
    libonig-dev \
    mariadb-client \
    && docker-php-ext-install \
    pdo pdo_mysql mysqli \
    zip xml intl mbstring \
    && a2enmod rewrite

WORKDIR /var/www/html

RUN git clone --depth 1 --branch $MOODLE_VERSION https://github.com/moodle/moodle.git /var/www/html \
    && mkdir -p /var/www/moodledata \
    && chown -R www-data:www-data /var/www/html /var/www/moodledata

COPY moodle-bootstrap.php /tmp/moodle-bootstrap.php

EXPOSE 80
