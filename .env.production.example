# .env.production.example — Variables de entorno para VPS
# Copiar a /opt/medicamentum360/.env.production en el VPS y llenar con valores reales.
# NUNCA commitees este archivo con valores reales.

# ===== Database =====
DATABASE_URL=postgresql://medicamentum:CAMBIAR@postgres:5432/medicamentum360?sslmode=disable
DIRECT_URL=postgresql://medicamentum:CAMBIAR@postgres:5432/medicamentum360?sslmode=disable

POSTGRES_USER=medicamentum
POSTGRES_PASSWORD=GENERAR_CON_openssl_rand_base64_32

# ===== Better Auth =====
BETTER_AUTH_SECRET=GENERAR_CON_openssl_rand_base64_32
BETTER_AUTH_URL=https://medicamentum360.com

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ===== Wompi =====
WOMPI_PUBLIC_KEY=...
WOMPI_PRIVATE_KEY=...
WOMPI_EVENTS_SECRET=...

# ===== Moodle =====
MOODLE_BASE_URL=https://lms.medicamentum360.com
MOODLE_WS_TOKEN=...

# ===== Redis =====
REDIS_PASSWORD=GENERAR_CON_openssl_rand_base64_32

# ===== Meilisearch =====
MEILI_MASTER_KEY=GENERAR_CON_openssl_rand_base64_32

# ===== Storage — Cloudflare R2 =====
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_BUCKET=medicamentum360
STORAGE_PUBLIC_URL=https://storage.medicamentum360.com

# ===== Email — Brevo =====
BREVO_API_KEY=...

# ===== Brand =====
NEXT_PUBLIC_BRAND_COLOR=#8127cf
